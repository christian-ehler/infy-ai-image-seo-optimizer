msgid "Google Consistent Image URLs Guidance"
msgstr "Panduan URL Imej Konsisten Google"

#: includes/views/seo-score-page.php:532
msgid ""
"May 12, 2025 update - Use the same image URL wherever the same image appears"
" to save crawl budget and improve indexing efficiency."
msgstr ""
