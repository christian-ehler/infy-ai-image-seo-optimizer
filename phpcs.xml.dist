<?xml version="1.0"?>
<ruleset name="Infy AI Image SEO Optimizer">
	<description>Security, database, i18n and PHP compatibility checks for the plugin. Run through scripts/check.sh.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/docs/*</exclude-pattern>
	<exclude-pattern>/changelog/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/scripts/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<!-- Plugin requires PHP 8.0; check every version up to 8.5. -->
	<config name="testVersion" value="8.0-8.5"/>
	<!-- Plugin requires WordPress 6.1. -->
	<config name="minimum_wp_version" value="6.1"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="infy-ai-image-seo-optimizer"/>
			</property>
		</properties>
	</rule>
</ruleset>
